ACTUAL_BUDGET_ID=
ACTUAL_BUDGET_PASSWORD=
ACTUAL_BUDGET_SERVER_URL=# http://localhost:5006
ACTUAL_BUDGET_UP_ACCOUNT_ID=
ACTUAL_BUDGET_ENCRYPTION_PASSWORD= # Only Required if budget file has end-to-end encryption enabled
UP_BANK_SYNC_START=# Date & time in rfc-3339 format YYYY-MM-DDTHH:MM:SS[Z or +HH:MM]

CRON_SCHEDULE="0 * * * *" #schedule for updates i.e. "0 * * * *" will update transactions on minute 0 of every hour (hourly). "0 * 1/1 * *" will update transcations at minute 0 of every day (daily).

UTC_TIMEZONE_OFFSET=0 #Defaults to 0, but add your local UTC offset like +10 or -10

# left is up id, right is actual budget id
UP_ACCOUNT_MAPPING='{
    "up_account1": "actual_budget_account1",
    "up_account2": "actual_budget_account1"
}'

UP_BANK_ACCESS_TOKEN=


# =============================================================================
# Net Worth → Google Sheets sync (net-worth-sync.js)
# =============================================================================

# Google Sheets spreadsheet ID (the long ID from the URL)
GOOGLE_SHEETS_SPREADSHEET_ID=

# Sheet tab name — defaults to Sheet1 if omitted
GOOGLE_SHEETS_SHEET_NAME=Sheet1

# Google Service Account credentials.
# Option A (recommended for Docker): paste the entire JSON key as a single line
GOOGLE_SERVICE_ACCOUNT_JSON=

# Option B: path to the downloaded JSON key file
GOOGLE_APPLICATION_CREDENTIALS=

# Maps Actual Budget account names to the exact names in the "Bank" column of
# your sheet. Only needed when the names differ. Format:
#   "Actual Budget Name": "Sheet Row Name"
NETWORTH_ACCOUNT_MAPPING='{
    "Macquarie Savings": "S - Macquarie",
    "2Up": "2Up Transaction",
    "Up Savings": "S - Up Bank",
    "ING Transaction": "A - ING Transaction",
    "ING Savings": "A - ING Savings",
    "Cash": "Cash",
    "Unity Bank Offset": "Unity Offset",
    "Bendigo Credit Card": "Bendigo CC"
}'
